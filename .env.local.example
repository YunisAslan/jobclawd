# ──────────────────────────────────────────────
# JobClawd — Local Development Environment
# ──────────────────────────────────────────────
# 1. Copy to .env:            cp .env.local.example .env
# 2. Fill in the REQUIRED values (marked below)
# 3. Run the app (see README → Getting Started)
# .env is gitignored — never commit real secrets.
#
# AI is bring-your-own-key: you do NOT set an OpenAI key here. After signing in,
# add your key in the app (Settings → OpenAI API key). Every user brings their own.

ENV=development

# ── General ──
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (REQUIRED) ──
# These defaults match the local Postgres created by `docker compose up`.
# If you run Postgres yourself, point DATABASE_URL at it.
# Note: inside Docker the host is `postgres`; running the API on the host use `localhost`.
POSTGRES_USER=jobclawd
POSTGRES_PASSWORD=jobclawd
POSTGRES_DB=jobclawd
DATABASE_URL=postgresql://jobclawd:jobclawd@localhost:5432/jobclawd

# ── Auth / JWT (REQUIRED) ──
# Generate one:  openssl rand -hex 32
JWT_SECRET=

# ── SMTP (needed for magic-link email login) ──
# Leave blank if you only use Google sign-in. Any SMTP provider works; for local
# testing you can use a catcher like Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
SUPPORT_EMAIL=support@localhost

# ── Google OAuth (OPTIONAL — needed only for "Sign in with Google") ──
# In Google Cloud Console → Credentials, add this exact Authorized redirect URI:
#   http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_JOBCLAWD_EMAIL=support@localhost

# ── OpenAI (model + base URL only — the KEY is per-user, added in the app) ──
# Choose any Chat Completions model your users' keys can access.
OPENAI_METADATA_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Secrets encryption (OPTIONAL) ──
# Encrypts stored user OpenAI keys at rest. Falls back to JWT_SECRET if unset.
# Keep it stable — changing it invalidates already-stored keys.
APP_ENCRYPTION_SECRET=
