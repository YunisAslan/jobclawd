# ──────────────────────────────────────────────
# JobClawd — Root Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── General ──
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://localhost:5432/jobclawd
POSTGRES_USER=jobclawd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobclawd

# ── Auth / JWT ──
JWT_SECRET=changeme-generate-a-random-secret

# ── Gmail SMTP (magic link emails) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# ── GitHub ──
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Frontend (Next.js public vars) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_JOBCLAWD_EMAIL=
