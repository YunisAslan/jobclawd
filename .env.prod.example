# ──────────────────────────────────────────────
# JobClawd — Production Environment Variables
# ──────────────────────────────────────────────
# 1. Copy to .env.prod on the server:  cp .env.prod.example .env.prod
# 2. Fill in all values below
# 3. Deploy:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# NEVER commit .env.prod (it is gitignored).

ENV=production

# ── Domains ──
APP_DOMAIN=jobclawd.com
API_DOMAIN=api.jobclawd.com

# ── General ──
FRONTEND_URL=https://jobclawd.com
ALLOWED_ORIGINS=https://jobclawd.com

# ── Database ──
# Use the SAME password in both POSTGRES_PASSWORD and DATABASE_URL.
# Generate: openssl rand -base64 24
POSTGRES_USER=jobclawd
POSTGRES_PASSWORD=
POSTGRES_DB=jobclawd
DATABASE_URL=postgresql://jobclawd:@postgres:5432/jobclawd

# ── Auth / JWT ──
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── SMTP ──
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=noreply@jobclawd.com
SMTP_PASSWORD=
MAIL_FROM=noreply@jobclawd.com
SUPPORT_EMAIL=support@jobclawd.com

# ── Google OAuth ──
# Add https://api.jobclawd.com/api/auth/callback/google to Google Cloud Console → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.jobclawd.com/api/auth/callback/google

# ── Frontend ──
NEXT_PUBLIC_API_URL=https://api.jobclawd.com
NEXT_PUBLIC_JOBCLAWD_EMAIL=support@jobclawd.com

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_METADATA_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1
