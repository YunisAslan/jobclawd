FROM node:20-alpine AS builder

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_JOBCLAWD_EMAIL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_JOBCLAWD_EMAIL=${NEXT_PUBLIC_JOBCLAWD_EMAIL}

COPY packages/shared /repo/packages/shared
COPY apps/web/package.json apps/web/package-lock.json /repo/apps/web/

WORKDIR /repo/apps/web
RUN npm install

COPY apps/web/ .
RUN npm run build


FROM node:20-alpine AS runner

ENV NODE_ENV=production

COPY --from=builder /repo/packages/shared /repo/packages/shared
COPY --from=builder /repo/apps/web /repo/apps/web

WORKDIR /repo/apps/web

EXPOSE 3000

CMD ["npm", "run", "start"]
